    "    print(f\" - MSE (test)  : {mean_squared_error(y_test, y_test_pred):.4f}\")\n",
    "    print(f\" - MAE (test)  : {mean_absolute_error(y_test, y_test_pred):.4f}\")\n",
    "    print(f\" - MAPE (test) : {mape(y_test, y_test_pred):.2f}%\")"
