    "max_filtered_lines = 0\n",
    "file_with_max_filtered_lines = None\n",
    "dropped_lines_final = 0\n",
    "\n",
    "for file in os.listdir(folder_path):\n",
    "    if file.endswith(\".json\"):\n",
    "        file_path = os.path.join(folder_path, file)\n",
    "        with open(file_path, \"r\", encoding=\"utf-8\") as f:\n",
    "            content = json.load(f)\n",
    "            if isinstance(content, dict) and \"data\" in content:\n",
    "                df_temp = pd.DataFrame(content[\"data\"])\n",
    "                initial_len = len(df_temp)\n",
    "\n",
    "                # Conversion en numérique (robuste)\n",
    "                df_temp['associated_uncertainty'] = pd.to_numeric(\n",
    "                    df_temp['associated_uncertainty'], errors='coerce'\n",
    "                )\n",
    "                df_temp['orthometric_height_of_water_surface_at_reference_position'] = pd.to_numeric(\n",
    "                    df_temp['orthometric_height_of_water_surface_at_reference_position'], errors='coerce'\n",
    "                )\n",
    "\n",
    "                # Filtrage des incertitudes + suppression des doublons\n",
    "                condition = df_temp['associated_uncertainty'] <= (\n",
    "                    0.25 * df_temp['orthometric_height_of_water_surface_at_reference_position']\n",
    "                )\n",
    "                df_filtered_temp = df_temp[condition].drop_duplicates(subset=['datetime'])\n",
    "\n",
    "                filtered_len = len(df_filtered_temp)\n",
    "\n",
    "                if filtered_len > max_filtered_lines:\n",
    "                    max_filtered_lines = filtered_len\n",
    "                    file_with_max_filtered_lines = file\n",
    "                    dropped_lines_final = initial_len - filtered_len\n",
    "\n",
    "# Résultat final\n",
    "print(\"\\n Fichier avec le plus de lignes après filtrage :\")\n",
    "print(f\" - Nom du fichier       : {file_with_max_filtered_lines}\")\n",
    "print(f\" - Lignes restantes     : {max_filtered_lines}\")\n",
    "print(f\" - Lignes supprimées    : {dropped_lines_final}\")\n"
   ]
