    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.linear_model import LinearRegression\n",
    "from sklearn.model_selection import TimeSeriesSplit\n",
    "\n",
    "# 1. Créer les lags\n",
    "lags = 5\n",
    "df = df_modelisation.copy()\n",
    "\n",
    "# Créer les colonnes de lags\n",
    "for i in range(1, lags + 1):\n",
    "    df[f\"lag{i}\"] = df[\"water_height\"].shift(i)\n",
    "\n",
    "# Supprimer les lignes avec NaN (générées par les shifts)\n",
    "df.dropna(inplace=True)\n",
    "\n",
    "# Définir X et y\n",
    "X = df[[f\"lag{i}\" for i in range(1, lags + 1)]].copy()\n",
    "y = df[\"water_height\"].copy()\n",
    "\n",
    "# Réinitialiser les index pour éviter les décalages lors du slicing\n",
    "X.reset_index(drop=True, inplace=True)\n",
    "y.reset_index(drop=True, inplace=True)\n",
    "\n",
    "# 2. Cross-validation avec TimeSeriesSplit\n",
    "tscv = TimeSeriesSplit(n_splits=5)\n",
    "\n",
    "# Pour stocker toutes les vraies valeurs et les prédictions\n",
    "y_true_all = []\n",
    "y_pred_all = []\n",
    "\n",
    "for train_index, test_index in tscv.split(X):\n",
    "    X_train, X_test = X.iloc[train_index], X.iloc[test_index]\n",
    "    y_train, y_test = y.iloc[train_index], y.iloc[test_index]\n",
    "\n",
    "    # Créer et entraîner le modèle\n",
    "    LinReg = LinearRegression()\n",
    "    LinReg.fit(X_train, y_train)\n",
    "\n",
    "    # Prédire\n",
    "    y_pred = LinReg.predict(X_test)\n",
    "\n",
    "    # Empiler les résultats pour traçage final\n",
    "    y_true_all.extend(y_test.tolist())\n",
    "    y_pred_all.extend(y_pred.tolist())\n",
    "\n",
    "# Convertir en séries pandas pour l'affichage\n",
    "y_true_all = pd.Series(y_true_all, name=\"Valeur réelle\")\n",
    "y_pred_all = pd.Series(y_pred_all, name=\"Valeur prédite\")\n",
    "\n",
    "# 3. Tracer les résultats\n",
    "plt.figure(figsize=(12, 6))\n",
    "plt.plot(y_true_all.index, y_true_all, label='Valeur réelle', color='blue')\n",
    "plt.plot(y_pred_all.index, y_pred_all, label='Valeur prédite', color='orange')\n",
    "plt.title(\"Valeur réelle vs prédite du niveau d’eau - régression linéaire\")\n",
    "plt.xlabel(\"Index temporel\")\n",
    "plt.ylabel(\"Niveau d’eau (m)\")\n",
    "plt.legend()\n",
    "plt.grid(True)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
