    "\n",
    "# Paramètres\n",
    "window_size = 1000  # taille du premier ensemble d’entraînement\n",
    "step = 20          # taille de chaque test\n",
    "n_obs = len(X)\n",
    "\n",
    "rmse_list = []\n",
    "preds = []\n",
    "reals = []\n",
    "# Boucle glissante\n",
    "for start in range(0, n_obs - window_size - step, step):\n",
    "    train_end = start + window_size\n",
    "    test_end = train_end + step\n",
    "\n",
    "    X_train, y_train = X.iloc[start:train_end], y.iloc[start:train_end]\n",
    "    X_test, y_test = X.iloc[train_end:test_end], y.iloc[train_end:test_end]\n",
    "\n",
    "    model = LinearRegression()\n",
    "    model.fit(X_train, y_train)\n",
    "    y_pred = model.predict(X_test)\n",
    "\n",
    "    rmse = mean_squared_error(y_test, y_pred, squared=False)\n",
    "    rmse_list.append(rmse)\n",
    "\n",
    "    preds.extend(y_pred)\n",
    "    reals.extend(y_test)\n",
    "\n",
    "# Affichage des performances\n",
    "print(f\"RMSE moyen sur toutes les fenêtres : {np.mean(rmse_list):.4f}\")\n",
    "\n",
    "# Graphique global\n",
    "plt.figure(figsize=(14, 6))\n",
    "plt.plot(reals, label=\"Valeur réelle\", color='blue')\n",
    "plt.plot(preds, label=\"Valeur prédite\", color='orange')\n",
    "plt.title(\"Expanding Window : Prédiction vs Réel\")\n",
    "plt.xlabel(\"Pas de temps\")\n",
    "plt.ylabel(\"Niveau d’eau (m)\")\n",
    "plt.legend()\n",
    "plt.grid()\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
