    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from pmdarima import auto_arima\n",
    "from statsmodels.tsa.statespace.sarimax import SARIMAX\n",
    "\n",
    "# --- 1. Charger et préparer les données ---\n",
    "#  Assurez-vous d’avoir une colonne 'datetime' dans df_modelisation\n",
    "df_modelisation['datetime'] = pd.to_datetime(df_modelisation['datetime'])\n",
    "df_modelisation.set_index('datetime', inplace=True)\n",
    "\n",
    "y = df_modelisation['water_height']\n",
    "\n",
    "# --- 2. Trouver les meilleurs paramètres avec auto_arima ---\n",
    "stepwise_model = auto_arima(\n",
    "    y,\n",
    "    start_p=1, start_q=1,\n",
    "    max_p=5, max_q=5,\n",
    "    seasonal=True,\n",
    "    m=12,  # Modifier selon la saisonnalité (ex : 12 = annuel, 30 = mensuel si données quotidiennes)\n",
    "    start_P=0, max_P=2, max_Q=2,\n",
    "    d=None, D=None,\n",
    "    trace=True,\n",
    "    error_action='ignore',\n",
    "    suppress_warnings=True,\n",
    "    stepwise=True\n",
    ")\n",
    "\n",
    "print(stepwise_model.summary())\n",
    "\n",
    "# --- 3. Réentraîner un SARIMAX avec les meilleurs paramètres ---\n",
    "order = stepwise_model.order\n",
    "seasonal_order = stepwise_model.seasonal_order\n",
    "\n",
    "model = SARIMAX(y, order=order, seasonal_order=seasonal_order)\n",
    "model_fit = model.fit()\n",
    "\n",
    "# --- 4. Prévoir les 30 prochains jours ---\n",
    "n_steps = 30\n",
    "forecast = model_fit.predict(start=len(y), end=len(y) + n_steps - 1, typ='levels')\n",
    "\n",
    "# Corriger l'index temporel pour les prévisions\n",
    "future_index = pd.date_range(start=y.index[-1] + pd.Timedelta(days=1), periods=n_steps, freq='D')\n",
    "forecast.index = future_index\n",
    "\n",
    "# --- 5. Visualisation ---\n",
    "plt.figure(figsize=(14, 6))\n",
    "plt.plot(y.index, y, label='Valeur réelle')\n",
    "plt.plot(forecast.index, forecast, label='Prévision future', color='orange')\n",
    "plt.title(\"Prévision future du niveau d’eau avec SARIMA optimisé\")\n",
