    "# 1. Construction du dataset avec variables retardées (lags)\n",
    "df_modelisation['lag_1'] = df_modelisation['water_height'].shift(1)\n",
    "df_modelisation['lag_2'] = df_modelisation['water_height'].shift(2)\n",
    "df_modelisation['lag_3'] = df_modelisation['water_height'].shift(3)\n",
    "df_modelisation['lag_5'] = df_modelisation['water_height'].shift(5)\n",
    "df_modelisation['lag_7'] = df_modelisation['water_height'].shift(7)\n",
    "df_modelisation['lag_10'] = df_modelisation['water_height'].shift(10)\n",
    "\n",
    "# 2. Ajouter des variables temporelles simples\n",
    "# 2. Ajouter des variables temporelles simples\n",
    "df_modelisation.index = pd.to_datetime(df_modelisation.index)\n",
    "df_modelisation['day_of_year'] = df_modelisation.index.dayofyear\n",
    "\n",
    "\n",
    "# 3. Définir la target\n",
    "df_modelisation['target'] = df_modelisation['water_height']\n",
    "\n",
    "# Nettoyer (supprimer les NaN dus aux lags)\n",
    "df_model = df_modelisation[['target', 'lag_1', 'lag_2', 'lag_3', 'lag_5', 'lag_7', 'lag_10', 'day_of_year']].dropna()\n",
    "\n",
    "# Variables explicatives et cible\n",
    "X = df_model[['lag_1', 'lag_2', 'lag_3', 'lag_5', 'lag_7', 'lag_10', 'day_of_year']]\n",
    "y = df_model['target']\n",
    "\n",
    "# 4. SPLIT TEMPOREL\n",
    "train_size = 0.8  # 80% pour l'entraînement\n",
    "train_index = int(len(X) * train_size)\n",
    "\n",
    "X_train = X.iloc[:train_index]\n",
    "X_test = X.iloc[train_index:]\n",
    "y_train = y.iloc[:train_index]\n",
    "y_test = y.iloc[train_index:]\n",
    "\n",
    "# 1. Imports\n",
    "from sklearn.linear_model import LinearRegression\n",
    "from sklearn.metrics import mean_squared_error, r2_score\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# 2. Modèle Linear Regression simple\n",
    "model = LinearRegression()\n",
    "model.fit(X_train, y_train)\n",
    "\n",
    "# 3. Prédictions\n",
    "y_pred = model.predict(X_test)\n",
    "\n",
    "# 4. Évaluation\n",
    "rmse = np.sqrt(mean_squared_error(y_test, y_pred))\n",
    "r2 = r2_score(y_test, y_pred)\n",
    "\n",
    "print(f\"RMSE : {rmse:.3f}\")\n",
    "print(f\"R² : {r2:.3f}\")\n",
    "\n",
    "# 5. Visualisation\n",
    "\n",
    "plt.plot(y_test.values, label='Réel', linewidth=2)\n",
    "plt.plot(y_pred, label='Prédit', linestyle='--')\n",
    "plt.legend()\n",
    "plt.title(\"Prédiction du niveau d’eau vs. valeurs réelles (Linear Regression simple)\")\n",
